import { Button, CheckBox, Palette, TabWidget } from "std-widgets.slint";

export struct ProfileRow {
    id: string,
    name: string,
    folder: string,
    enabled: bool,
}

export struct HistoryRow {
    source: string,
    output: string,
    status: string,
    error-message: string,
}

const COLOR_PRIMARY: color = #2563EB;
const COLOR_PRIMARY_DARK: color = #1D4ED8;
const COLOR_PRIMARY_LIGHT: color = #3B82F6;
const COLOR_SUCCESS: color = #10B981;
const COLOR_WARNING: color = #F59E0B;
const COLOR_ERROR: color = #EF4444;
const COLOR_BACKGROUND: color = #F8FAFC;
const COLOR_CARD: color = #FFFFFF;
const COLOR_TEXT_PRIMARY: color = #1E293B;
const COLOR_TEXT_SECONDARY: color = #64748B;
const COLOR_BORDER: color = #E2E8F0;
const COLOR_HOVER: color = rgba(37, 99, 235, 8%);
const COLOR_ACTIVE: color = rgba(37, 99, 235, 12%);
const SPACING_XS: length = 4px;
const SPACING_SM: length = 8px;
const SPACING_MD: length = 16px;
const SPACING_LG: length = 24px;
const SPACING_XL: length = 32px;
const RADIUS_SM: length = 6px;
const RADIUS_MD: length = 8px;
const RADIUS_LG: length = 12px;

component SectionTitle inherits Text {
    font-size: 24px;
    font-weight: 700;
    color: COLOR_TEXT_PRIMARY;
}

component Subtitle inherits Text {
    font-size: 15px;
    font-weight: 500;
    color: COLOR_TEXT_PRIMARY;
}

component Label inherits Text {
    font-size: 12px;
    font-weight: 500;
    color: COLOR_TEXT_SECONDARY;
}

component StatusText inherits Text {
    font-size: 13px;
    color: COLOR_TEXT_SECONDARY;
}

component SuccessText inherits Text {
    font-size: 13px;
    color: COLOR_SUCCESS;
}

component ErrorText inherits Text {
    font-size: 13px;
    color: COLOR_ERROR;
}

component WarningText inherits Text {
    font-size: 13px;
    color: COLOR_WARNING;
}

component TextField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;

    horizontal-stretch: 1;
    height: 44px;
    vertical-stretch: 0;
    border-width: 1.5px;
    border-color: input.has-focus ? COLOR_PRIMARY : COLOR_BORDER;
    border-radius: RADIUS_MD;
    background: COLOR_CARD;

    animate border-color { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 0;

        input := TextInput {
            text <=> root.value;
            font-size: 14px;
            color: COLOR_TEXT_PRIMARY;
            selection-background-color: COLOR_PRIMARY;
            selection-foreground-color: COLOR_CARD;
            vertical-alignment: center;
        }
    }

    Text {
        visible: root.value == "" && !input.has-focus;
        x: 14px;
        width: root.width - 28px;
        height: 100%;
        text: root.placeholder;
        font-size: 14px;
        color: COLOR_TEXT_SECONDARY;
        vertical-alignment: center;
        opacity: 0.6;
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 100px;
    height: 42px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: COLOR_BORDER;
    border-radius: RADIUS_MD;
    background: touch.has-hover ? #F3F6FA : COLOR_CARD;

    animate background { duration: 120ms; easing: ease-out; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: COLOR_TEXT_PRIMARY;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        letter-spacing: 0.3px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 200px;
    height: 44px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-width: 0px;
    border-radius: RADIUS_MD;
    background: touch.has-hover ? COLOR_PRIMARY_LIGHT : COLOR_PRIMARY;

    animate background { duration: 150ms; easing: ease-out; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: COLOR_CARD;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        letter-spacing: 0.4px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: COLOR_CARD;
    border-radius: RADIUS_LG;
    border-width: 1px;
    border-color: COLOR_BORDER;
}

component TextRow inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    height: 72px;
    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: SPACING_SM;
        Label { text: root.label; }
        TextField {
            value <=> root.value;
            placeholder: root.placeholder;
        }
    }
}

component PathRow inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    callback browse;

    height: 72px;
    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: SPACING_SM;
        Label { text: root.label; }
        HorizontalLayout {
            spacing: SPACING_MD;
            TextField {
                value <=> root.value;
                placeholder: root.placeholder;
            }
            SecondaryButton { text: "Browse"; clicked => { root.browse(); } }
        }
    }
}

component StatusBadge inherits Rectangle {
    in property <string> status;
    
    width: 80px;
    height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: RADIUS_SM;
    background: COLOR_BACKGROUND;

    HorizontalLayout {
        spacing: SPACING_XS;
        padding: 8px;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.status == "success" ? COLOR_SUCCESS
                : root.status == "failed" ? COLOR_ERROR
                : root.status == "skipped" ? COLOR_WARNING
                : root.status == "processing" ? COLOR_PRIMARY
                : COLOR_TEXT_SECONDARY;
        }

        Text {
            text: root.status;
            font-size: 11px;
            font-weight: 600;
            color: root.status == "success" ? COLOR_SUCCESS
                : root.status == "failed" ? COLOR_ERROR
                : root.status == "skipped" ? COLOR_WARNING
                : root.status == "processing" ? COLOR_PRIMARY
                : COLOR_TEXT_SECONDARY;
        }
    }
}

component ProfileListRow inherits Rectangle {
    in property <ProfileRow> profile;
    callback delete-profile(string);
    callback toggle-profile(string, bool);

    height: 56px;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: COLOR_BORDER;
    border-radius: RADIUS_MD;
    background: COLOR_CARD;

    touch := TouchArea {}

    HorizontalLayout {
        spacing: SPACING_MD;
        padding: 16px;

        CheckBox {
            checked: root.profile.enabled;
            changed checked => { root.toggle-profile(root.profile.id, self.checked); }
        }
        
        Text {
            text: root.profile.name;
            font-size: 14px;
            font-weight: 600;
            color: COLOR_TEXT_PRIMARY;
            min-width: 160px;
        }
        
        Text {
            text: root.profile.folder;
            font-size: 12px;
            color: COLOR_TEXT_SECONDARY;
            horizontal-stretch: 1;
            max-width: 200px;
            overflow: elide;
        }
        
        Button {
            text: "Delete";
            clicked => { root.delete-profile(root.profile.id); }
        }
    }
}

component HistoryListRow inherits Rectangle {
    in property <HistoryRow> item;

    height: 56px;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: COLOR_BORDER;
    border-radius: RADIUS_MD;
    background: COLOR_CARD;

    HorizontalLayout {
        spacing: SPACING_MD;
        padding: 16px;
        
        StatusBadge {
            status: root.item.status;
        }
        
        VerticalLayout {
            spacing: SPACING_XS;
            
            Text { 
                text: root.item.source; 
                font-size: 13px; 
                color: COLOR_TEXT_PRIMARY; 
                horizontal-stretch: 1;
            }
            Text { 
                text: root.item.output; 
                font-size: 11px; 
                color: COLOR_TEXT_SECONDARY;
            }

            ErrorText { 
                visible: root.item.error-message != "";
                text: root.item.error-message;
                font-size: 11px;
            }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <string> input-path;
    in-out property <string> output-folder;
    in-out property <bool> remove-backticks;
    in-out property <bool> auto-detect-dates;
    in-out property <bool> delete-source;
    in-out property <string> status-message: "Ready";
    
    in-out property <string> conversion-result: "";
    in-out property <bool> conversion-success: false;

    in property <[ProfileRow]> profiles;
    in property <[HistoryRow]> history-items;
    in-out property <string> profile-name;
    in-out property <string> watch-folder;
    in-out property <string> monitor-output-folder;
    in-out property <bool> process-existing: true;
    in-out property <bool> monitor-delete-source;
    in-out property <bool> monitor-auto-detect-dates;
    in-out property <bool> monitor-csv-enabled: true;
    in-out property <bool> monitor-xls-enabled: true;
    in-out property <string> exclude-keywords;
    in-out property <bool> auto-startup-enabled;
    in-out property <bool> context-menu-enabled;

    callback convert-file();
    callback add-profile();
    callback delete-profile(string);
    callback toggle-profile(string, bool);
    callback save-settings();
    callback browse-input-file();
    callback browse-output-folder();
    callback browse-watch-folder();
    callback browse-monitor-output-folder();
    callback refresh-history();

    title: "CSV/XLS to XLSX Converter";
    width: 1080px;
    height: 760px;
    init => {
        Palette.color-scheme = ColorScheme.light;
    }
    background: COLOR_BACKGROUND;

    TabWidget {
        
        Tab {
            title: "Convert";
            VerticalLayout {
                padding: SPACING_LG;
                spacing: SPACING_MD;
                
                SectionTitle { 
                    text: "Convert Single File"; 
                }
                
                Subtitle {
                    text: "Choose a CSV or XLS file and convert it to modern XLSX format.";
                    font-size: 13px;
                    color: COLOR_TEXT_SECONDARY;
                }
                
                Card {
                    VerticalLayout {
                        spacing: SPACING_MD;
                        
                        HorizontalLayout {
                            spacing: SPACING_MD;
                            PathRow {
                                label: "Input file";
                                placeholder: "Paste path or click Browse";
                                value <=> root.input-path;
                                browse => { root.browse-input-file(); }
                                horizontal-stretch: 1;
                            }
                        }
                        
                        HorizontalLayout {
                            padding-top: SPACING_SM;
                            PathRow {
                                label: "Output folder";
                                placeholder: "Optional - same as input folder";
                                value <=> root.output-folder;
                                browse => { root.browse-output-folder(); }
                                horizontal-stretch: 1;
                            }
                        }
                        
                        HorizontalLayout {
                            spacing: SPACING_LG;
                            CheckBox { 
                                text: "Remove backticks"; 
                                checked <=> root.remove-backticks; 
                            }
                            
                            CheckBox { 
                                text: "Auto-detect dates"; 
                                checked <=> root.auto-detect-dates; 
                            }
                            
                            CheckBox { 
                                text: "Delete original"; 
                                checked <=> root.delete-source; 
                            }
                        }
                    }
                }
                
                PrimaryButton { 
                    text: "Convert to XLSX"; 
                    clicked => { root.convert-file(); }
                }
                
                StatusText { 
                    text: root.status-message; 
                    visible: root.status-message != "Ready" && root.conversion-result == "";
                }
                
                SuccessText {
                    text: "✅ " + root.conversion-result;
                    visible: root.conversion-success;
                }
                
                ErrorText {
                    text: "❌ " + root.conversion-result;
                    visible: root.conversion-result != "" && !root.conversion-success;
                }
            }
        }
        Tab {
            title: "Monitor";
            VerticalLayout {
                padding: SPACING_LG;
                spacing: SPACING_MD;
                
                SectionTitle { 
                    text: "Folder Monitoring Profiles"; 
                }
                
                Subtitle {
                    text: "Automatically convert files dropped into monitored folders.";
                    font-size: 13px;
                    color: COLOR_TEXT_SECONDARY;
                }
                
                Card {
                    VerticalLayout {
                        spacing: SPACING_MD;
                        
                        HorizontalLayout {
                            spacing: SPACING_MD;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: SPACING_MD;
                                
                                TextField {
                                    placeholder: "Profile name";
                                    value <=> root.profile-name;
                                }
                                
                                PathRow {
                                    label: "Watch folder";
                                    placeholder: "Folder to monitor";
                                    value <=> root.watch-folder;
                                    browse => { root.browse-watch-folder(); }
                                    horizontal-stretch: 1;
                                }
                                
                                PathRow {
                                    label: "Output folder";
                                    placeholder: "Optional - same as watch folder";
                                    value <=> root.monitor-output-folder;
                                    browse => { root.browse-monitor-output-folder(); }
                                    horizontal-stretch: 1;
                                }
                            }
                            
                            VerticalLayout {
                                spacing: SPACING_MD;
                                
                                Label { 
                                    text: "Options"; 
                                }
                                Rectangle { height: SPACING_XS; }
                                CheckBox { 
                                    text: "Process existing files"; 
                                    checked <=> root.process-existing;
                                }
                                CheckBox { 
                                    text: "Delete source after conversion"; 
                                    checked <=> root.monitor-delete-source;
                                }
                                CheckBox { 
                                    text: "Auto-detect dates"; 
                                    checked <=> root.monitor-auto-detect-dates;
                                }
                                CheckBox { 
                                    text: "CSV files"; 
                                    checked <=> root.monitor-csv-enabled;
                                }
                                CheckBox { 
                                    text: "XLS files"; 
                                    checked <=> root.monitor-xls-enabled;
                                }
                            }
                        }
                        
                        TextField {
                            placeholder: "Exclude keywords (comma-separated, e.g., temp, backup, draft)";
                            value <=> root.exclude-keywords;
                        }
                    }
                }
                
                PrimaryButton { 
                    text: "Add Profile"; 
                    clicked => { root.add-profile(); }
                }
                
                if root.profiles.length > 0 {
                    VerticalLayout {
                        spacing: SPACING_SM;
                        padding-top: SPACING_MD;
                        
                        Label { 
                            text: "Active Profiles"; 
                        }
                        Rectangle { height: SPACING_XS; }
                        
                        for profile in root.profiles: ProfileListRow {
                            profile: profile;
                            delete-profile(id) => { root.delete-profile(id); }
                            toggle-profile(id, enabled) => { root.toggle-profile(id, enabled); }
                        }
                    }
                } else {
                    Rectangle {
                        height: 80px;
                        border-radius: RADIUS_MD;
                        background: COLOR_BACKGROUND;
                        HorizontalLayout {
                            padding: SPACING_MD;
                            spacing: SPACING_MD;
                            
                            Text {
                                text: "📁";
                                font-size: 32px;
                            }
                            
                            Rectangle { width: SPACING_MD; }
                            
                            VerticalLayout {
                                spacing: SPACING_SM;
                                
                                Text {
                                    text: "No profiles created yet";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: COLOR_TEXT_PRIMARY;
                                }
                                
                                Text {
                                    text: "Create one to start monitoring a folder.";
                                    font-size: 13px;
                                    color: COLOR_TEXT_SECONDARY;
                                }
                            }
                        }
                    }
                }
            }
        }
        Tab {
            title: "History";
            VerticalLayout {
                padding: SPACING_LG;
                spacing: SPACING_MD;
                
                SectionTitle { 
                    text: "Conversion History"; 
                }
                
                Subtitle {
                    text: "Recent conversion activity and results.";
                    font-size: 13px;
                    color: COLOR_TEXT_SECONDARY;
                }
                
                if root.history-items.length > 0 {
                    VerticalLayout {
                        spacing: SPACING_SM;
                        
                        for item in root.history-items: HistoryListRow {
                            item: item;
                        }
                    }
                } else {
                    Rectangle {
                        height: 120px;
                        border-radius: RADIUS_LG;
                        background: COLOR_BACKGROUND;
                        HorizontalLayout {
                            padding: SPACING_MD;
                            spacing: SPACING_MD;
                            
                            Text {
                                text: "📁";
                                font-size: 32px;
                            }
                            
                            Rectangle { width: SPACING_MD; }
                            
                            VerticalLayout {
                                spacing: SPACING_SM;
                                
                                Text {
                                    text: "No conversions yet";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: COLOR_TEXT_PRIMARY;
                                }
                                
                                Text {
                                    text: "Convert a file or set up monitoring to get started.";
                                    font-size: 13px;
                                    color: COLOR_TEXT_SECONDARY;
                                }
                            }
                        }
                    }
                }
            }
        }
        Tab {
            title: "Settings";
            VerticalLayout {
                padding: SPACING_LG;
                spacing: SPACING_MD;
                
                SectionTitle { 
                    text: "Application Settings"; 
                }
                
                Subtitle {
                    text: "Configure how the application behaves.";
                    font-size: 13px;
                    color: COLOR_TEXT_SECONDARY;
                }
                
                Card {
                    VerticalLayout {
                        spacing: SPACING_MD;
                        
                        Label { 
                            text: "Startup & Integration"; 
                            font-size: 14px;
                            font-weight: 600;
                        }
                        
                        CheckBox { 
                            text: "Start with Windows"; 
                            checked <=> root.auto-startup-enabled;
                        }
                        
                        CheckBox { 
                            text: "Add Explorer context menu"; 
                            checked <=> root.context-menu-enabled;
                        }
                        
                        StatusText {
                            text: "After enabling, you may need to restart the application for changes to take effect.";
                            font-size: 12px;
                            color: COLOR_TEXT_SECONDARY;
                            opacity: 0.8;
                        }
                    }
                }
                
                PrimaryButton { 
                    text: "Save Settings"; 
                    clicked => { root.save-settings(); }
                }
                
                StatusText { 
                    text: "Settings are stored in %APPDATA%\\csv-xls-converter\\profiles.json"; 
                    font-size: 11px;
                    opacity: 0.7;
                }
            }
        }
    }
}
