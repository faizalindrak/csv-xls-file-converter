import { Button, CheckBox, Palette, TabWidget } from "std-widgets.slint";

export struct ProfileRow {
    id: string,
    name: string,
    folder: string,
    enabled: bool,
}

export struct HistoryRow {
    source: string,
    output: string,
    status: string,
}

component SectionTitle inherits Text {
    font-size: 22px;
    font-weight: 600;
    color: #1B1F24;
}

component Label inherits Text {
    font-size: 13px;
    color: #4B5563;
}

component StatusText inherits Text {
    font-size: 13px;
    color: #4B5563;
}

component TextField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;

    horizontal-stretch: 1;
    height: 40px;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: input.has-focus ? #2563EB : #B8C2CF;
    border-radius: 6px;
    background: #FFFFFF;

    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        input := TextInput {
            text <=> root.value;
            font-size: 14px;
            color: #1B1F24;
            selection-background-color: #2563EB;
            selection-foreground-color: #FFFFFF;
            vertical-alignment: center;
        }
    }

    Text {
        visible: root.value == "" && !input.has-focus;
        x: 12px;
        width: root.width - 24px;
        height: 100%;
        text: root.placeholder;
        font-size: 14px;
        color: #4B5563;
        vertical-alignment: center;
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 96px;
    height: 40px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: #B8C2CF;
    border-radius: 6px;
    background: touch.pressed ? #DCE6F3 : touch.has-hover ? #F3F6FA : #FFFFFF;

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: #1B1F24;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 180px;
    height: 40px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: #1D4ED8;
    border-radius: 6px;
    background: touch.pressed ? #1D4ED8 : touch.has-hover ? #1D4ED8 : #2563EB;

    animate background { duration: 100ms; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextRow inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    height: 64px;
    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: 6px;
        Label { text: root.label; }
        TextField {
            value <=> root.value;
            placeholder: root.placeholder;
        }
    }
}

component PathRow inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    callback browse;

    height: 64px;
    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: 6px;
        Label { text: root.label; }
        HorizontalLayout {
            spacing: 8px;
            TextField {
                value <=> root.value;
                placeholder: root.placeholder;
            }
            SecondaryButton { text: "Browse"; clicked => { root.browse(); } }
        }
    }
}

component ProfileListRow inherits Rectangle {
    in property <ProfileRow> profile;
    callback delete-profile(string);
    callback toggle-profile(string, bool);

    height: 48px;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: #D7DEE8;
    border-radius: 8px;
    background: #FFFFFF;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        CheckBox {
            checked: root.profile.enabled;
            changed checked => { root.toggle-profile(root.profile.id, self.checked); }
        }
        Text {
            text: root.profile.name;
            font-size: 14px;
            font-weight: 600;
            color: #1B1F24;
            min-width: 160px;
        }
        Text {
            text: root.profile.folder;
            font-size: 13px;
            color: #4B5563;
            horizontal-stretch: 1;
        }
        Button {
            text: "Delete";
            clicked => { root.delete-profile(root.profile.id); }
        }
    }
}

component HistoryListRow inherits Rectangle {
    in property <HistoryRow> item;

    height: 48px;
    vertical-stretch: 0;
    border-width: 1px;
    border-color: #D7DEE8;
    border-radius: 8px;
    background: #FFFFFF;

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Text { text: root.item.status; font-size: 13px; min-width: 80px; color: #2563EB; }
        Text { text: root.item.source; font-size: 13px; color: #1B1F24; horizontal-stretch: 1; }
        Text { text: root.item.output; font-size: 13px; color: #4B5563; horizontal-stretch: 1; }
    }
}

export component AppWindow inherits Window {
    in-out property <string> input-path;
    in-out property <string> output-folder;
    in-out property <bool> remove-backticks;
    in-out property <bool> auto-detect-dates;
    in-out property <bool> delete-source;
    in-out property <string> status-message: "Ready";

    in property <[ProfileRow]> profiles;
    in property <[HistoryRow]> history-items;
    in-out property <string> profile-name;
    in-out property <string> watch-folder;
    in-out property <string> monitor-output-folder;
    in-out property <bool> process-existing: true;
    in-out property <bool> monitor-delete-source;
    in-out property <bool> monitor-auto-detect-dates;
    in-out property <bool> monitor-csv-enabled: true;
    in-out property <bool> monitor-xls-enabled: true;
    in-out property <string> exclude-keywords;
    in-out property <bool> auto-startup-enabled;
    in-out property <bool> context-menu-enabled;

    callback convert-file();
    callback add-profile();
    callback delete-profile(string);
    callback toggle-profile(string, bool);
    callback save-settings();
    callback browse-input-file();
    callback browse-output-folder();
    callback browse-watch-folder();
    callback browse-monitor-output-folder();

    title: "CSV/XLS Converter";
    width: 1040px;
    height: 720px;
    init => {
        Palette.color-scheme = ColorScheme.light;
    }
    background: #EEF2F7;

    TabWidget {
        Tab {
            title: "Convert";
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                SectionTitle { text: "Convert Single File"; }
                PathRow {
                    label: "Input file";
                    placeholder: "Paste a CSV, XLS, or XLSX path";
                    value <=> root.input-path;
                    browse => { root.browse-input-file(); }
                }
                PathRow {
                    label: "Output folder";
                    placeholder: "Optional folder path";
                    value <=> root.output-folder;
                    browse => { root.browse-output-folder(); }
                }
                HorizontalLayout {
                    spacing: 16px;
                    CheckBox { text: "Remove backticks"; checked <=> root.remove-backticks; }
                    CheckBox { text: "Auto-detect dates"; checked <=> root.auto-detect-dates; }
                    CheckBox { text: "Delete original"; checked <=> root.delete-source; }
                }
                PrimaryButton { text: "Convert to XLSX"; clicked => { root.convert-file(); } }
                StatusText { text: root.status-message; }
            }
        }
        Tab {
            title: "Monitor";
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                SectionTitle { text: "Monitor Profiles"; }
                TextRow { label: "Profile name"; placeholder: "Profile name"; value <=> root.profile-name; }
                PathRow {
                    label: "Watch folder";
                    placeholder: "Folder to monitor";
                    value <=> root.watch-folder;
                    browse => { root.browse-watch-folder(); }
                }
                PathRow {
                    label: "Output folder";
                    placeholder: "Optional output folder";
                    value <=> root.monitor-output-folder;
                    browse => { root.browse-monitor-output-folder(); }
                }
                HorizontalLayout {
                    spacing: 16px;
                    CheckBox { text: "Process existing"; checked <=> root.process-existing; }
                    CheckBox { text: "Delete source"; checked <=> root.monitor-delete-source; }
                    CheckBox { text: "Auto-detect dates"; checked <=> root.monitor-auto-detect-dates; }
                    CheckBox { text: "CSV"; checked <=> root.monitor-csv-enabled; }
                    CheckBox { text: "XLS"; checked <=> root.monitor-xls-enabled; }
                }
                TextField { value <=> root.exclude-keywords; placeholder: "Exclude keywords, comma-separated"; }
                PrimaryButton { text: "Add Profile"; clicked => { root.add-profile(); } }
                for profile in root.profiles: ProfileListRow {
                    profile: profile;
                    delete-profile(id) => { root.delete-profile(id); }
                    toggle-profile(id, enabled) => { root.toggle-profile(id, enabled); }
                }
            }
        }
        Tab {
            title: "History";
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                SectionTitle { text: "Recent Conversions"; }
                for item in root.history-items: HistoryListRow { item: item; }
            }
        }
        Tab {
            title: "Settings";
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                SectionTitle { text: "Settings"; }
                CheckBox { text: "Start with Windows"; checked <=> root.auto-startup-enabled; }
                CheckBox { text: "Explorer context menu"; checked <=> root.context-menu-enabled; }
                PrimaryButton { text: "Save Settings"; clicked => { root.save-settings(); } }
                StatusText { text: "Settings are stored in the existing AppData profile file."; }
            }
        }
    }
}
